# ================================================================
# Portfolio Optimization Docker Environment Configuration
# ================================================================
# Copy this file to .env and customize the values for your deployment

# ===== GENERAL CONFIGURATION =====
COMPOSE_PROJECT_NAME=portfolio-optimization
TIMEZONE=UTC

# ===== HOST DIRECTORIES =====
# Local directories to bind mount for data persistence
HOST_DATA_DIR=./data
HOST_LOGS_DIR=./logs
HOST_DB_DIR=./database/data
HOST_BACKUP_DIR=./database/backups
SSL_CERT_DIR=./config/ssl

# ===== DATABASE CONFIGURATION =====
# PostgreSQL settings
POSTGRES_ENABLED=true
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=portfolio_optimization
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=secure_password_change_me

# Database performance tuning
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_WORK_MEM=4MB

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Migration and storage strategy
ENABLE_FILE_STORAGE=true
ENABLE_DATABASE_STORAGE=true

# ===== BACKUP CONFIGURATION =====
# Automated backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# ===== PORTFOLIO ANALYSIS PARAMETERS =====
# Financial calculation settings
RISK_FREE_RATE=0.02
MIN_WEIGHT_THRESHOLD=0.01
MAX_STOCKS=100
RISK_AVERSION=2.5
TAU=0.025

# Financial Modeling Prep API Key (get free key at https://financialmodelingprep.com/)
FMP_API_KEY=USIa8HA0z2NCAdBwL1ZEHnpMaxe73DF8

# Data fetching configuration
HISTORICAL_PERIOD=5y
REQUEST_DELAY=1.0
MAX_RETRIES=3

# Logging configuration
LOG_LEVEL=INFO

# ===== NGINX REVERSE PROXY =====
# Web server configuration
NGINX_HOST=localhost
HTTP_PORT=80
HTTPS_PORT=443

# ===== DASHBOARD CONFIGURATION =====
# Streamlit dashboard settings
DASHBOARD_TITLE=Portfolio Optimization Dashboard
DASHBOARD_ICON=📈

# ===== SCHEDULER CONFIGURATION =====
# Cron schedule for automated pipeline runs
# Format: minute hour day month day-of-week
# Examples:
#   0 6 * * *     # Daily at 6 AM UTC
#   0 6 * * 1     # Weekly on Monday at 6 AM UTC
#   0 6 1 * *     # Monthly on 1st day at 6 AM UTC
CRON_SCHEDULE=0 6 * * *

# Notification settings
NOTIFICATION_ENABLED=false
WEBHOOK_URL=

# ===== CLOUDFLARE TUNNEL (Optional) =====
# Only required if using Cloudflare Tunnel for external access
# Get token from: https://one.dash.cloudflare.com/
CLOUDFLARE_TUNNEL_TOKEN=

# ===== SECURITY SETTINGS =====
# Basic authentication (if needed)
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# HTTPS/SSL Configuration
SSL_ENABLED=false
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ===== DEVELOPMENT SETTINGS =====
# Only used with development profile
DEBUG=false

# ===== RESOURCE LIMITS =====
# Container resource allocation (optional overrides)
DATA_PIPELINE_MEMORY_LIMIT=2G
DATA_PIPELINE_CPU_LIMIT=1.5
DASHBOARD_MEMORY_LIMIT=1G
DASHBOARD_CPU_LIMIT=1.0
NGINX_MEMORY_LIMIT=256M
NGINX_CPU_LIMIT=0.5

# ===== MONITORING (Future Enhancement) =====
# Prometheus and Grafana settings
# MONITORING_ENABLED=false
# GRAFANA_ADMIN_PASSWORD=admin
# PROMETHEUS_RETENTION=15d

# ===== PERFORMANCE TUNING =====
# Advanced performance settings
WORKER_PROCESSES=auto
WORKER_CONNECTIONS=1024
CLIENT_MAX_BODY_SIZE=10M

# Redis cache settings
REDIS_ENABLED=true
REDIS_MAX_MEMORY=256mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru

# ===== NETWORK CONFIGURATION =====
# Docker network settings (advanced users only)
DOCKER_SUBNET=172.20.0.0/16
DOCKER_GATEWAY=172.20.0.1

# ===== LOGGING CONFIGURATION =====
# Docker logging driver settings
LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true